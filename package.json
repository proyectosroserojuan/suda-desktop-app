{
  "name": "audiometria-app",
  "productName": "S.U.D.A LUIS IGNACIO SANIN",
  "version": "1.0.23",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . audiometria-app --platform=win32 --arch=x64 --out=dist --overwrite",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always" 
  },
  "build": {
    "win": {
      "target": "nsis",
      "icon": "build/ico.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.dll"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "proyectosroserojuan",
        "repo": "suda-desktop-app"
      }
    ]
  },
  "keywords": [],
  "author": "Juan Camilo Rosero Campaz",
  "license": "ISC",
  "description": "Sistema de Audiometría",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "ffmpeg-static": "^5.3.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "canvas": "^3.2.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  }
}
